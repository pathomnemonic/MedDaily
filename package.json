{
  "name": "meddaily",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "native:sync": "npm run build && cap sync",
    "native:icons": "capacitor-assets generate --ios --android --iconBackgroundColor '#d9432c' --splashBackgroundColor '#100b2e' && node scripts/restore-web-assets.mjs",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@sentry/browser": "^11.17.0",
    "@supabase/supabase-js": "^2.119.2",
    "firebase": "^13.4.0",
    "posthog-js": "^1.454.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
