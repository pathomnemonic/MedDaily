rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      function joining() {
        return signedIn()
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 8
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "updatedAt"]);
      }

      function leaving() {
        return isMember()
          && !(request.auth.uid in request.resource.data.memberUids)
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "updatedAt"]);
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.status == "waiting";

      allow update: if joining()
        || leaving()
        || (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "playing");

      allow delete: if isMember() && resource.data.memberUids.size() == 1;

      match /players/{playerUid} {
        function parentRoom() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function roomMember() {
          return signedIn() && request.auth.uid in parentRoom().memberUids;
        }

        allow get, list: if roomMember();

        allow create: if signedIn()
          && request.auth.uid == playerUid
          && request.resource.data.uid == playerUid
          && request.resource.data.keys().hasOnly(["uid", "name", "score", "maxScore", "finished", "perfect"])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.score == null
          && request.resource.data.maxScore == null
          && request.resource.data.perfect == false
          && request.resource.data.finished == false
          && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if signedIn()
          && request.auth.uid == playerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["score", "maxScore", "finished", "perfect"])
          && resource.data.finished == false
          && resource.data.score == null
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.maxScore is number
          && request.resource.data.maxScore > 0
          && request.resource.data.score <= request.resource.data.maxScore
          && request.resource.data.perfect is bool
          && (!request.resource.data.perfect || request.resource.data.score == request.resource.data.maxScore)
          && request.resource.data.finished == true;

        allow delete: if signedIn() && request.auth.uid == playerUid;
      }
    }
  }
}